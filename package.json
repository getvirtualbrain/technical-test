{
  "name": "getvirtualbrain-technical-test",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo --parallel --filter \"@getvirtualbrain-technical-test/*\" dev",
    "build": "turbo  --filter \"@getvirtualbrain-technical-test/*\" build",
    "lint": "turbo --parallel  --filter \"@getvirtualbrain-technical-test/*\" lint",
    "test": "turbo --parallel  --filter \"@getvirtualbrain-technical-test/*\" test",
    "clean": "rimraf --glob 'apps/**/node_modules' 'packages/**/node_modules' 'node_modules'",
    "clean:turbo": "rimraf --glob 'apps/**/.turbo' 'packages/**/.turbo' '.turbo'",
    "clean:build": "rimraf --glob 'apps/**/dist' 'packages/**/dist'",
    "clean:store": "pnpm store prune",
    "format": "prettier --cache --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^15.15.0",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "rimraf": "^6.0.1",
    "turbo": "^2.5.6",
    "typescript-eslint": "^8.39.0"
  }
}
